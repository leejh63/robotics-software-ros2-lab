<?xml version="1.0"?>
<sdf version="1.6">
  <world name="simple_maze_world">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="simple_maze">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Outer boundary: 6m x 6m -->
      <link name="north_wall">
        <pose>0 3.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient></material>
        </visual>
      </link>

      <link name="south_wall">
        <pose>0 -3.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient></material>
        </visual>
      </link>

      <link name="east_wall">
        <pose>3.0 0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient></material>
        </visual>
      </link>

      <link name="west_wall">
        <pose>-3.0 0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient></material>
        </visual>
      </link>

      <!-- Interior maze walls. Corridors are kept wide for the TurtleBot model. -->
      <link name="maze_wall_1">
        <pose>-1.8 0.75 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 3.3 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.3 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_2">
        <pose>-0.65 1.55 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.3 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.3 0.1 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_3">
        <pose>0.75 1.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 2.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.2 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_4">
        <pose>1.8 0.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.3 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.3 0.1 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_5">
        <pose>1.65 -1.45 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 2.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.1 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_6">
        <pose>0.25 -1.65 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_7">
        <pose>-0.85 -1.05 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 1.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.2 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>

      <link name="maze_wall_8">
        <pose>-2.15 -0.65 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.4 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.1 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.0 0.7 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
