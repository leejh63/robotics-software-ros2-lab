  <version>0.0.0</version>
  <description>ROS2 camera, OpenCV, YOLO image, and custom detection message examples.</description>
  <maintainer email="leejh63@users.noreply.github.com">Jaeho Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
