<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_tf_examples</name>
  <version>0.0.0</version>
  <description>ROS2 TF tree, listener, and YOLO object transform examples.</description>
  <maintainer email="leejh63@users.noreply.github.com">Jaeho Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>
  <depend>geometry_msgs</depend>
  <depend>ros2_foundation_interfaces</depend>

  <exec_depend>launch</exec_depend>

  <exec_depend>launch_ros</exec_depend>

  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>ros2_camera_examples</exec_depend>

  <exec_depend>rqt_tf_tree</exec_depend>

  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
